        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nskinparam usecase {\n  BackgroundColor #F0A500\n  BorderColor #B7770D\n  FontColor #000000\n  FontSize 11\n  FontName Arial\n  FontStyle bold\n}\nskinparam actor {\n  BorderColor #1A5276\n  FontSize 12\n  FontName Arial\n  FontStyle bold\n  BackgroundColor white\n}\nskinparam ArrowColor #333333\nskinparam ArrowFontSize 9\nskinparam ArrowFontName Arial\nskinparam rectangle {\n  BackgroundColor #A8D8B9\n  BorderColor #1A5276\n  FontSize 13\n  FontStyle bold\n}\n\nactor \&quot;Kasir\&quot; as kasir\nactor \&quot;Administrator\&quot; as admin\n\nrectangle \&quot;Use Case Diagram BarberFlow POS\&quot; {\n\n  usecase \&quot;Login Akun\&quot; as UC1\n  usecase \&quot;Buka Shift Kasir\&quot; as UC2\n  usecase \&quot;Input Transaksi POS\&quot; as UC3\n  usecase \&quot;Cetak Struk Belanja\&quot; as UC4\n  usecase \&quot;Lihat Riwayat Transaksi\&quot; as UC5\n  usecase \&quot;Kelola Data Barber\&quot; as UC6\n  usecase \&quot;Kelola Data Layanan\&quot; as UC7\n  usecase \&quot;Kelola Pengeluaran\&quot; as UC8\n  usecase \&quot;Lihat Dashboard\&quot; as UC9\n  usecase \&quot;Export Laporan PDF/Excel\&quot; as UC10\n\n  usecase \&quot;Validasi Password\&quot; as EX1\n  usecase \&quot;Input Modal Awal\&quot; as EX2\n  usecase \&quot;Pilih Layanan &amp; Barber\&quot; as EX3\n  usecase \&quot;Hitung Kembalian\&quot; as EX4\n  usecase \&quot;Rekapitulasi Kas\&quot; as EX5\n\n}\n\n&#39; Kasir di KIRI\nkasir --&gt; UC1\nkasir --&gt; UC2\nkasir --&gt; UC3\nkasir --&gt; UC4\nkasir --&gt; UC5\n\n&#39; Admin di KANAN\nadmin --&gt; UC1\nadmin --&gt; UC2\nadmin --&gt; UC3\nadmin --&gt; UC5\nadmin --&gt; UC6\nadmin --&gt; UC7\nadmin --&gt; UC8\nadmin --&gt; UC9\nadmin --&gt; UC10\n\n&#39; extend / include ke sisi kanan dalam kotak\nUC1 ..&gt; EX1 : «include»\nUC2 ..&gt; EX2 : «include»\nUC3 ..&gt; EX3 : «include»\nUC3 ..&gt; EX4 : «include»\nUC2 &lt;.. EX5 : «extend»\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XCmXzBKAF5f6tQvpce3p-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
