  <diagram id="zMGlRxjy6f0BzSJqNW7V" name="FLOWCHART MANUAL">
    <mxGraphModel dx="4835" dy="3040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef startEnd fill:#D4AF37,stroke:#000,stroke-width:2px,color:#000,font-weight:bold;\n    classDef process fill:#1E293B,stroke:#94A3B8,stroke-width:2px,color:#FFF;\n    classDef decision fill:#854D0E,stroke:#F59E0B,stroke-width:2px,color:#FFF;\n    classDef document fill:#0284C7,stroke:#38BDF8,stroke-width:2px,color:#FFF;\n    classDef manual fill:#334155,stroke:#64748B,stroke-width:2px,color:#FFF;\n\n    Start([Mulai: Pelanggan Datang Walk-In]):::startEnd --&gt; QueueCheck{Antrean Tempat Duduk Penuh?}:::decision\n    \n    QueueCheck -- \&quot;Ya\&quot; --&gt; WaitManual[Pelanggan Menunggu Antrean Fisik di Barbershop]:::manual\n    WaitManual --&gt; ServiceSelect[Pelanggan Menyampaikan Pilihan Layanan Secara Lisan]:::process\n    \n    QueueCheck -- \&quot;Tidak\&quot; --&gt; ServiceSelect\n    \n    ServiceSelect --&gt; Grooming[Barber Stylist Melakukan Pengerjaan Cukur &amp; Grooming]:::process\n    Grooming --&gt; CalcTotal[Kasir Menghitung Total Biaya Manual / Kalkulator]:::process\n    \n    CalcTotal --&gt; PayCash[Pelanggan Membayar dengan Uang Tunai / Cash]:::process\n    PayCash --&gt; WriteReceipt[/Kasir Menulis Nota Transaksi di Buku Nota Kertas/]::document\n    \n    WriteReceipt --&gt; GiveReceipt[Kasir Menyerahkan Nota Kertas &amp; Kembalian Uang]:::process\n    GiveReceipt --&gt; RecordLedger[/Kasir Mencatat Transaksi di Buku Kas Harian Kertas/]::document\n    \n    RecordLedger --&gt; ShiftEndCheck{Operasional Hari Ini Selesai / Tutup?}:::decision\n    \n    ShiftEndCheck -- \&quot;Belum\&quot; --&gt; WaitNext[Melayani Pelanggan Berikutnya]:::manual\n    WaitNext --&gt; QueueCheck\n    \n    ShiftEndCheck -- \&quot;Ya\&quot; --&gt; CountCashManual[Kasir Hitung Manual Uang Fisik Laci &amp; Total Buku Kas]:::process\n    CountCashManual --&gt; HandoverOwner[/Kasir Serahkan Uang Setoran &amp; Buku Kas Kertas ke Owner/]::document\n    \n    HandoverOwner --&gt; OwnerCheck{Owner Cek Rekap Buku Kas &amp; Fisik Uang?}:::decision\n    \n    OwnerCheck -- \&quot;Cocok / Sesuai\&quot; --&gt; End([Selesai: Rekapitulasi Pembukuan Manual Selesai]):::startEnd\n    OwnerCheck -- \&quot;Selisih Uang / Typo\&quot; --&gt; AuditManual[Owner Lakukan Audit Rekapitulasi Manual]:::process\n    AuditManual --&gt; End&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hh1cJthFECqSRMKJnUem-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
