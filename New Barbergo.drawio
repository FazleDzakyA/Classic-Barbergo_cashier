        <UserObject label="1. Login / Registrasi Akun" mermaidId="n:LoginProcess" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#1E293B;strokeColor=#38BDF8;fontColor=#FFF;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="1. Login / Registrasi Akun" id="r8UiNgtnyZOvcJxqSq_g-3">
          <mxCell parent="r8UiNgtnyZOvcJxqSq_g-1" style="html=1;whiteSpace=wrap;strokeWidth=2;fillColor=#1E293B;strokeColor=#38BDF8;fontColor=#FFF;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
