        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    classDef entity fill:#2B3A4A,stroke:#2B3A4A,color:#FFF,stroke-width:2px;\n    classDef rel fill:#2B3A4A,stroke:#2B3A4A,color:#FFF,stroke-width:2px;\n    classDef attr fill:#2B3A4A,stroke:#2B3A4A,color:#FFF,stroke-width:2px;\n\n    %% ENTITAS UTAMA (KOTAK PERSEGI)\n    User[\&quot;User / Pelanggan\&quot;]:::entity\n    Barber[\&quot;Kasir / Barber\&quot;]:::entity\n    Layanan[\&quot;Layanan Barbershop\&quot;]:::entity\n    Laporan[\&quot;Laporan Shift\&quot;]:::entity\n\n    %% RELASI (BELAH KETUPAT)\n    Booking{\&quot;Melakukan&lt;br/&gt;Booking\&quot;}:::rel\n    Trans{\&quot;Memilih&lt;br/&gt;Layanan\&quot;}:::rel\n    Verify{\&quot;Memverifikasi&lt;br/&gt;Shift\&quot;}:::rel\n\n    %% ATRIBUT USER (BULAT OVAL BUBBLE)\n    U_id(\&quot;&lt;u&gt;id_user&lt;/u&gt;\&quot;):::attr\n    U_nama(\&quot;nama\&quot;):::attr\n    U_ndepan(\&quot;nama_depan\&quot;):::attr\n    U_nbelakang(\&quot;nama_belakang\&quot;):::attr\n    U_email(\&quot;email\&quot;):::attr\n    U_role(\&quot;role\&quot;):::attr\n\n    User --- U_id\n    User --- U_nama\n    U_nama --- U_ndepan\n    U_nama --- U_nbelakang\n    User --- U_email\n    User --- U_role\n\n    %% ATRIBUT RELASI BOOKING (BULAT OVAL BUBBLE MENEMPEL DI BELAH KETUPAT)\n    B_idtrx(\&quot;&lt;u&gt;id_transaksi&lt;/u&gt;\&quot;):::attr\n    B_tgl(\&quot;tgl_transaksi\&quot;):::attr\n    B_total(\&quot;total_bayar\&quot;):::attr\n    B_metode(\&quot;metode_bayar\&quot;):::attr\n    B_status(\&quot;status_transaksi\&quot;):::attr\n\n    Booking --- B_idtrx\n    Booking --- B_tgl\n    Booking --- B_total\n    Booking --- B_metode\n    Booking --- B_status\n\n    %% ATRIBUT KASIR / BARBER (BULAT OVAL BUBBLE)\n    Bar_id(\&quot;&lt;u&gt;id_barber&lt;/u&gt;\&quot;):::attr\n    Bar_nama(\&quot;nama_barber\&quot;):::attr\n    Bar_shift(\&quot;shift_kerja\&quot;):::attr\n    Bar_status(\&quot;status_aktif\&quot;):::attr\n\n    Barber --- Bar_id\n    Barber --- Bar_nama\n    Barber --- Bar_shift\n    Barber --- Bar_status\n\n    %% ATRIBUT RELASI MEMILIH LAYANAN (BULAT OVAL BUBBLE MENEMPEL DI BELAH KETUPAT)\n    T_iddetail(\&quot;&lt;u&gt;id_detail&lt;/u&gt;\&quot;):::attr\n    T_subtotal(\&quot;subtotal\&quot;):::attr\n\n    Trans --- T_iddetail\n    Trans --- T_subtotal\n\n    %% ATRIBUT LAYANAN BARBERSHOP (BULAT OVAL BUBBLE)\n    L_id(\&quot;&lt;u&gt;id_layanan&lt;/u&gt;\&quot;):::attr\n    L_nama(\&quot;nama_layanan\&quot;):::attr\n    L_harga(\&quot;harga\&quot;):::attr\n    L_kategori(\&quot;kategori\&quot;):::attr\n    L_durasi(\&quot;durasi_menit\&quot;):::attr\n\n    Layanan --- L_id\n    Layanan --- L_nama\n    Layanan --- L_harga\n    Layanan --- L_kategori\n    Layanan --- L_durasi\n\n    %% ALUR RELASI UTAMA &amp; KARDINALITAS\n    User ---|1| Booking\n    Booking ---|Many| Barber\n    Barber ---|1| Trans\n    Trans ---|Many| Layanan\n    User ---|1| Verify\n    Verify ---|Many| Laporan&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dxca0YnLDvPt8qx6N-yQ-194">
