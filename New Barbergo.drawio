ng\ncashier --&gt; UC_ShiftReport\n\nadmin --&gt; UC_Login\nadmin --&gt; UC_VerifyReport\nadmin --&gt; UC_MasterData\nadmin --&gt; UC_Analytics\n\nUC_Booking .&gt; UC_Catalog : &lt;&lt;include&gt;&gt;\nUC_POS .&gt; UC_ManageBooking : &lt;&lt;extend&gt;&gt;\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cDG00DIVZf8AnQ7cLYJM-1">
