        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USER ||--o{ TRANSAKSI : \&quot;1,1 Melakukan 0,n\&quot;\n    BARBER ||--o{ TRANSAKSI : \&quot;1,1 Melayani 0,n\&quot;\n    TRANSAKSI ||--|{ DETAIL_TRANSAKSI : \&quot;1,1 Memiliki 1,n\&quot;\n    LAYANAN ||--o{ DETAIL_TRANSAKSI : \&quot;1,1 Dimuat Dalam 0,n\&quot;\n    USER ||--o{ LAPORAN_SHIFT : \&quot;1,1 Memverifikasi 0,n\&quot;\n\n    USER {\n        string id_user PK\n        string nama_user\n        string email_user\n        string role_user\n        string no_hp\n        datetime tgl_dibuat\n    }\n\n    BARBER {\n        int id_barber PK\n        string nama_barber\n        string shift_barber\n        boolean status_aktif\n        string foto_barber\n    }\n\n    LAYANAN {\n        int id_layanan PK\n        string nama_layanan\n        decimal harga_layanan\n        int durasi_menit\n        string kategori\n    }\n\n    TRANSAKSI {\n        string id_transaksi PK\n        string nama_customer\n        string no_hp_customer\n        date tgl_transaksi\n        string jam_transaksi\n        decimal total_bayar\n        string metode_pembayaran\n        string status_transaksi\n        string catatan\n    }\n\n    DETAIL_TRANSAKSI {\n        int id_detail PK\n        string id_transaksi FK\n        int id_layanan FK\n        decimal subtotal\n    }\n\n    LAPORAN_SHIFT {\n        string id_laporan PK\n        date tgl_laporan\n        string nama_kasir\n        decimal uang_fisik_cash\n        decimal total_qris_system\n        int total_transaksi\n        string status_verifikasi\n        datetime tgl_submit\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Fx_tXvFGXPo7m-UQwySs-106">
